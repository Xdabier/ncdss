# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# JWT Secret - Change this in production!
JWT_SECRET=ncdss-secret-key-change-in-production
JWT_REFRESH_SECRET=ncdss-refresh-secret-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# =============================================================================
# LLM Configuration (Ollama - fully offline)
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_ENABLE_THINKING=true

# Model Options (use exact tag from 'ollama list'):
# - qwen3:latest    (recommended - best balance, thinking mode)
# - deepseek-r1:8b  (best medical validation, always-on thinking)
# - qwen3:4b        (lightweight, very capable)
# - qwen2.5:7b-instruct (no thinking, fastest)
