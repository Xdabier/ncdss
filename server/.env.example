# =============================================================================
# NCDSS server configuration
# =============================================================================
# Copy this file to server/.env and adjust the values.
# Every variable is optional in development.

# development or production
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# The server refuses to start when NODE_ENV=production and this is missing.
# Use a long random value, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string

# Allowed origins in production, comma separated.
# In development every origin is allowed.
CORS_ORIGINS=http://localhost:3001,capacitor://localhost

# =============================================================================
# Local LLM (node-llama-cpp, fully offline, optional)
# =============================================================================
# The app starts without a model, but pathology and intervention suggestions stay empty.

# Folder that holds the GGUF model files
LLAMA_MODELS_DIR=./models

# Model file name inside LLAMA_MODELS_DIR.
# When unset, the first .gguf file found in the folder is used.
# LLAMA_MODEL_FILE=my-model.Q8_0.gguf

# Full path to a model. Overrides LLAMA_MODEL_FILE and auto-detection.
# LLAMA_MODEL_PATH=./models/my-model.gguf

# Context window size (default: 2048 for fine-tuned models, 4096 for base models)
# LLAMA_CONTEXT_SIZE=2048

# GPU layers to offload (-1 or unset for auto-detect, 0 for CPU only)
# LLAMA_GPU_LAYERS=-1

# Qwen3 thinking mode for base models (ignored for fine-tuned models)
LLAMA_ENABLE_THINKING=true

# =============================================================================
# Claude API (optional alternative to the local LLM)
# =============================================================================
# Patient data leaves the machine when this provider is active.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Preferred provider: "local" or "claude".
# When unset, the local model is used if present, else Claude if a key is set.
# LLM_PROVIDER=local
