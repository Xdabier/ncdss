# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# JWT Secret - Change this in production!
JWT_SECRET=ncdss-secret-key-change-in-production
JWT_REFRESH_SECRET=ncdss-refresh-secret-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# =============================================================================
# LLM Configuration (node-llama-cpp - fully offline, GPU-accelerated)
# =============================================================================
# Directory containing GGUF model files
LLAMA_MODELS_DIR=./models

# Specific model filename (resolved against LLAMA_MODELS_DIR)
# For fine-tuned Apollo2-0.5B model (fast, 2-4s):
LLAMA_MODEL_FILE=ncdss-apollo-0.5B-v1-Q8_0.gguf
# For fine-tuned Apollo-1.8B fallback (slower, ~8-15s):
# LLAMA_MODEL_FILE=ncdss-apollo-1.8B-v1-Q8_0.gguf
# For base model (slow, 30s+, used for benchmarking):
# LLAMA_MODEL_FILE=hf_Qwen_Qwen3-0.6B.Q8_0.gguf

# Specific model full path (optional - overrides LLAMA_MODEL_FILE and auto-detection)
# LLAMA_MODEL_PATH=./models/Qwen3-8B-Q4_K_M.gguf

# Context window size (default: 2048 for fine-tuned models, 4096 for base models)
# LLAMA_CONTEXT_SIZE=2048

# GPU layers to offload (-1 or omit for auto-detect, 0 for CPU-only)
# LLAMA_GPU_LAYERS=-1

# Enable thinking mode for Qwen3 base models (adds /think prefix, ignored for fine-tuned)
LLAMA_ENABLE_THINKING=true

# =============================================================================
# Claude API Configuration (alternative to local LLM)
# =============================================================================
# Anthropic API key for Claude provider (optional — enables Claude API as LLM backend)
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM provider preference: "local" (default) or "claude"
# If not set, auto-detects: uses local model if available, falls back to Claude if API key set
# LLM_PROVIDER=local
