# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# JWT Secret - Change this in production!
JWT_SECRET=ncdss-secret-key-change-in-production
JWT_REFRESH_SECRET=ncdss-refresh-secret-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# =============================================================================
# LLM Configuration (node-llama-cpp - fully offline, GPU-accelerated)
# =============================================================================
# Directory containing GGUF model files
LLAMA_MODELS_DIR=./models

# Specific model path (optional - auto-detects .gguf files)
# LLAMA_MODEL_PATH=./models/Qwen3-8B-Q4_K_M.gguf

# Enable thinking mode for Qwen3 reasoning (adds /think prefix)
LLAMA_ENABLE_THINKING=true

# Recommended Models (Q4_K_M quantization for best quality/size balance):
# - Qwen3-8B (~5GB) - Best for French medical text, native thinking mode
# - Qwen3-4B (~2.5GB) - Lightweight, native thinking mode
#
# Download with: npm run models:pull (8B) or npm run models:pull-light (4B)
#
# Qwen3 features: /think mode, excellent French, strong JSON output
