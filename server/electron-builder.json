{
  "appId": "com.ncdss.server",
  "productName": "NCDSS Server",
  "electronVersion": "28.3.3",
  "directories": {
    "output": "release"
  },
  "files": ["dist-electron/**/*", "package.json"],
  "extraResources": [
    {
      "from": ".env",
      "to": ".env"
    }
  ],
  "win": {
    "target": ["zip"]
  },
  "linux": {
    "target": ["AppImage"]
  },
  "mac": {
    "target": ["dmg"]
  }
}
