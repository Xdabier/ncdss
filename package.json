{
  "name": "ncdss",
  "version": "1.0.0",
  "description": "Nursing Clinical Decision Support System",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm run dev:server & npm run dev:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build --workspace=shared && npm run build:server && npm run build:client",
    "lint": "eslint \"{client,server,shared}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{client,server,shared}/**/*.{ts,tsx,css,md,json}\""
  },
  "keywords": [
    "nursing",
    "clinical",
    "decision-support",
    "healthcare"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.0"
  }
}
