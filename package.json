{
  "name": "ncdss",
  "version": "1.0.0",
  "description": "Nursing Clinical Decision Support System for emergency rooms",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build --workspace=shared && npm run build:server && npm run build:client",
    "lint": "eslint \"{client,server,shared}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{client,server,shared}/**/*.{ts,tsx,css,md,json}\"",
    "rebuild:electron": "npm run rebuild:electron --workspace=server",
    "rebuild:node": "npm rebuild better-sqlite3",
    "db:push": "npm run db:push --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:studio": "npm run db:studio --workspace=server"
  },
  "keywords": [
    "nursing",
    "clinical",
    "decision-support",
    "healthcare",
    "triage",
    "emergency",
    "electron",
    "react"
  ],
  "author": "Badii Boutar",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xdabier/ncdss.git"
  },
  "homepage": "https://github.com/Xdabier/ncdss#readme",
  "bugs": {
    "url": "https://github.com/Xdabier/ncdss/issues"
  }
}
