# =============================================================================
# NCDSS Server Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# CRITICAL: You MUST set these in production. The server will refuse to start
# without them when NODE_ENV=production.

# JWT secret for access tokens (min 32 characters recommended)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# JWT secret for refresh tokens (min 32 characters recommended)
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins for production
# In development mode, all origins are allowed
CORS_ORIGINS=http://localhost:3001,capacitor://localhost

# =============================================================================
# Local LLM Configuration (Ollama - fully offline)
# =============================================================================
# The app works without Ollama (falls back to rule-based suggestions)
# See README.md for Ollama setup instructions

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
