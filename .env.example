# =============================================================================
# NCDSS Server Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================================================
# Security (REQUIRED in production)
# =============================================================================
# CRITICAL: You MUST set these in production. The server will refuse to start
# without them when NODE_ENV=production.

# JWT secret for access tokens (min 32 characters recommended)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# JWT secret for refresh tokens (min 32 characters recommended)
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins for production
# In development mode, all origins are allowed
CORS_ORIGINS=http://localhost:3001,capacitor://localhost

# =============================================================================
# Local LLM Configuration (node-llama-cpp - fully offline, GPU-accelerated)
# =============================================================================
# The app works without a model (falls back to rule-based suggestions)
# See MIGRATION_PLAN_NODE_LLAMA_CPP.md for model download instructions

# Directory containing GGUF model files (default: ./models)
LLAMA_MODELS_DIR=./models

# Specific model file path (optional - auto-detects .gguf in models dir)
# LLAMA_MODEL_PATH=./models/Qwen3-8B-Q4_K_M.gguf

# Enable thinking mode for Qwen3 reasoning (default: true)
# When enabled, adds /think prefix to prompts for step-by-step reasoning
LLAMA_ENABLE_THINKING=true

# Recommended Models (download one with: npm run models:pull):
# - Qwen3-8B-Q4_K_M.gguf (~5GB, best balance, native thinking mode, excellent French)
# - Qwen3-4B-Q4_K_M.gguf (~2.5GB, lightweight, native thinking mode)
#
# Qwen3 features:
# - Native /think and /no_think mode switching
# - Excellent multilingual support (French medical terminology)
# - Strong JSON output and instruction following
# - State-of-the-art reasoning capabilities
