{
  "name": "ncdss-client",
  "version": "1.0.0",
  "type": "module",
  "description": "NCDSS client: React app packaged with Capacitor",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "electron electron/main.js"
  },
  "dependencies": {
