    "@ncdss/shared": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "axios": "^1.6.5",
    "i18n-iso-countries": "^7.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.6.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
