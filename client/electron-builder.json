{
  "appId": "com.ncdss.client",
  "productName": "NCDSS Client",
  "electronVersion": "28.3.3",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"]
  },
  "linux": {
    "target": ["AppImage"]
  },
  "mac": {
    "target": ["dmg"]
  },
  "extraMetadata": {
    "main": "electron/main.js",
    "type": "commonjs"
  }
}
